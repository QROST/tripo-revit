<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.7.3" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="PdfPig.Filters.Jpx.OpenJpeg" Version="0.1.16.1" />
    <!-- Default catalog entry; Tripo.Revit overrides per build via $(RevitSdkVersion). -->
    <PackageVersion Include="Autodesk.Revit.SDK" Version="2026.0.0.9999" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.7" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="ModelContextProtocol" Version="1.4.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
